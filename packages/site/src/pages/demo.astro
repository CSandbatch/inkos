---
import DemoStudio from "../components/DemoStudio";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(`${base}/demo/`, Astro.site).toString();
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Explore NovelGraph Studio with a safe, seeded mystery project."/><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><title>NovelGraph Studio — Interactive Demo</title></head><body><DemoStudio client:load /></body></html>
