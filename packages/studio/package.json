  "scripts": { "dev": "tsx src/server.ts", "build": "vite build && tsc -p tsconfig.server.json", "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit", "test": "vitest run --passWithNoTests", "prepack": "node ../../scripts/prepare-package-for-publish.mjs", "postpack": "node ../../scripts/restore-package-json.mjs", "prepublishOnly": "node ../../scripts/verify-no-workspace-protocol.mjs ." },
  "dependencies": { "@actalk/novelgraph-core": "workspace:*", "@hono/node-server": "^2.0.12", "@tanstack/react-query": "^5.66.0", "@tiptap/extension-placeholder": "^3.0.0", "@tiptap/react": "^3.0.0", "@tiptap/starter-kit": "^3.0.0", "@xyflow/react": "^12.6.0", "cytoscape": "^3.31.0", "hono": "^4.6.14", "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": { "@types/cytoscape": "^3.21.9", "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^4.3.4", "tsx": "^4.19.2", "typescript": "^5.8.0", "vite": "^6.0.0", "vitest": "^3.0.0" }
}
