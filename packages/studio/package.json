{
  "name": "@actalk/novelgraph-studio",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "Local NovelGraph authoring and workflow control room",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/CSandbatch/novelgraph.git", "directory": "packages/studio" },
  "homepage": "https://csandbatch.github.io/novelgraph/",
  "files": ["dist", "!dist/**/*.test.*"],
  "exports": {
    ".": { "types": "./dist/server/server.d.ts", "import": "./dist/server/server.js" },
