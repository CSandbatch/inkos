{
  "name": "@actalk/novelgraph",
  "version": "0.5.0",
  "description": "NovelGraph CLI — local agent production OS for fiction",
  "type": "module",
  "bin": {
    "novelgraph": "dist/index.js"
  },
  "files": [
    "dist/index.*",
    "dist/runtime.*",
    "dist/commands/init.*",
    "dist/commands/config.*",
    "dist/commands/doctor.*",
    "dist/commands/inspect-prose.*",
    "dist/commands/studio.*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CSandbatch/novelgraph.git",
    "directory": "packages/cli"
  },
  "homepage": "https://csandbatch.github.io/novelgraph/",
  "bugs": { "url": "https://github.com/CSandbatch/novelgraph/issues" },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-for-publish.mjs",
    "postpack": "node ../../scripts/restore-package-json.mjs",
    "prepublishOnly": "node ../../scripts/verify-no-workspace-protocol.mjs .",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actalk/novelgraph-core": "workspace:*",
    "@actalk/novelgraph-studio": "workspace:*",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
