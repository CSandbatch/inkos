# NovelGraph Environment Configuration
# Copy to .env and fill in your values.
#
# CREDENTIALS DO NOT BELONG IN THIS FILE.
# Sign in instead:  novelgraph auth login --provider chatgpt
# Tokens are held in the operating system credential store (Windows DPAPI,
# macOS Keychain, or libsecret). Run 'novelgraph auth status' to see which.

# ── Provider sign-in (OAuth 2.0 device flow, RFC 8628) ───────────────────────
# NovelGraph does not ship an OAuth client ID. Register a device-flow client
# with your provider, then either run:
#   novelgraph auth configure --provider chatgpt --client-id <id> --issuer <url>
# or set these. Environment values override ~/.novelgraph/auth.json.
#
# NOVELGRAPH_CHATGPT_CLIENT_ID=
# NOVELGRAPH_CHATGPT_ISSUER=https://issuer.example.com
#
# Endpoints are discovered from the issuer's /.well-known/openid-configuration.
# Override only if the provider publishes no discovery document:
# NOVELGRAPH_CHATGPT_DEVICE_AUTHORIZATION_ENDPOINT=
# NOVELGRAPH_CHATGPT_TOKEN_ENDPOINT=
# NOVELGRAPH_CHATGPT_SCOPES=openid profile offline_access

# ── Inference target ─────────────────────────────────────────────────────────
NOVELGRAPH_LLM_PROVIDER=chatgpt
NOVELGRAPH_LLM_BASE_URL=https://api.openai.com/v1
NOVELGRAPH_LLM_MODEL=gpt-4o

# API-key authentication remains available for providers with no device flow.
# Prefer 'novelgraph auth login' where it is supported: a key written here is
# readable by anything that can read this file.
# NOVELGRAPH_LLM_API_KEY=

# ── Studio ───────────────────────────────────────────────────────────────────
# Studio binds to loopback unless this is explicitly changed.
NOVELGRAPH_STUDIO_HOST=127.0.0.1
NOVELGRAPH_STUDIO_PORT=4567

# ── Credential storage override (testing only) ───────────────────────────────
# Forces the unencrypted file backend instead of the OS credential store.
# NOVELGRAPH_SECRET_BACKEND=file
