{
  "name": "novelgraph",
  "version": "0.5.0",
  "private": true,
  "description": "Local fiction production through an inspectable story graph",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CSandbatch/novelgraph.git"
  },
  "homepage": "https://csandbatch.github.io/novelgraph/",
  "bugs": {
    "url": "https://github.com/CSandbatch/novelgraph/issues"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm -r dev",
    "test": "corepack pnpm -r test",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "verify:publish-manifests": "node scripts/verify-no-workspace-protocol.mjs packages/core packages/studio packages/cli",
    "copy:lint": "node scripts/lint-public-copy.mjs",
    "copy:report": "node scripts/lint-public-copy.mjs --report-only",
    "release": "corepack pnpm build && corepack pnpm test",
    "site:dev": "corepack pnpm --filter @actalk/novelgraph-site dev",
    "site:build": "corepack pnpm --filter @actalk/novelgraph-site build",
    "docs:generate": "corepack pnpm --filter @actalk/novelgraph-core build && node scripts/generate-fair-play-reference.mjs",
    "docs:check": "node scripts/generate-fair-play-reference.mjs --check",
    "diagrams:build": "node scripts/render-diagrams.mjs",
    "diagrams:check": "node scripts/render-diagrams.mjs --check"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
