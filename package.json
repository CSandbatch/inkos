{
  "name": "inkos",
  "version": "0.4.9",
  "private": true,
  "description": "Multi-agent novel production system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CSandbatch/inkos"
  },
  "homepage": "https://csandbatch.github.io/inkos/",
  "bugs": { "url": "https://github.com/CSandbatch/inkos/issues" },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "verify:publish-manifests": "node scripts/verify-no-workspace-protocol.mjs packages/core packages/studio packages/cli",
    "release": "pnpm build && pnpm test",
    "site:dev": "pnpm --filter @actalk/inkos-site dev",
    "site:build": "pnpm --filter @actalk/inkos-site build",
    "docs:generate": "corepack pnpm --filter @actalk/inkos-core build && node scripts/generate-fair-play-reference.mjs",
    "docs:check": "node scripts/generate-fair-play-reference.mjs --check"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  }
}
